<UserControl x:Class="SwitchDesk.App.CrossSavePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource Text}">
 <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CrossSave.HasSelection,Converter={StaticResource Visible},ConverterParameter=not}">
   <StackPanel>
    <TextBlock Text="换个平台，继续游玩" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="选择游戏，查找电脑与 Switch 的存档。先保留双端备份，再比较内容；只有通过具体版本验证的组合才会开放迁移。" Foreground="{DynamicResource Secondary}" Margin="0,10,0,20" MaxWidth="820" HorizontalAlignment="Left"/>
    <ItemsControl ItemsSource="{Binding CrossSave.Games}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Width="268" Margin="0,0,16,16" Padding="18" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
       Command="{Binding DataContext.Commands[CrossSaveSelectGame],RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
       <StackPanel>
        <DockPanel Margin="0,0,14,14"><TextBlock Text="↗" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="{Binding PcStatus}" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding SwitchStatus}" Margin="0,0,0,14"/>
        <TextBlock Text="{Binding SupportStatus}" Style="{StaticResource Muted}"/>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="首批六款均可发现电脑存档并独立备份。尚未核对 Switch 游戏标识的项目会明确标注，不能配对到其他游戏。" Style="{StaticResource Muted}" MaxWidth="820" HorizontalAlignment="Left" Margin="0,4,0,12"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Visibility="{Binding CrossSave.HasSelection,Converter={StaticResource Visible}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16">
    <Button Content="返回跨平台首页" Command="{Binding Commands[CrossSaveHome]}" DockPanel.Dock="Right"/>
    <TextBlock Text="{Binding CrossSave.SelectedGame.Name}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel IsEnabled="{Binding CrossSave.CanSelect}">
     <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
      <StackPanel>
       <DockPanel><Button Content="选择文件" Command="{Binding Commands[CrossSaveBrowse]}" DockPanel.Dock="Right"/><TextBlock Text="电脑 · Steam" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <ComboBox ItemsSource="{Binding CrossSave.Candidates}" SelectedItem="{Binding CrossSave.SelectedPc}" DisplayMemberPath="Label" Margin="0,12,0,10" AutomationProperties.Name="电脑存档与槽位"/>
       <TextBlock Text="{Binding CrossSave.PcSummary}" Margin="0,0,0,10"/>
       <Button Content="备份电脑存档" Command="{Binding Commands[CrossSaveBackupPc]}" HorizontalAlignment="Left"/>
      </StackPanel>
     </Border>
     <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="Switch" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="对应的 Switch 游戏" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
       <ComboBox ItemsSource="{Binding CrossSave.TargetGames}" SelectedItem="{Binding CrossSave.SelectedTargetGame}" DisplayMemberPath="Label" AutomationProperties.Name="跨平台对应的 Switch 游戏"/>
       <TextBlock Text="用户" Style="{StaticResource Muted}" Margin="0,12,0,6"/>
       <ComboBox ItemsSource="{Binding CrossSave.Users}" SelectedItem="{Binding CrossSave.SelectedUser}" DisplayMemberPath="Label" AutomationProperties.Name="跨平台目标 Switch 用户"/>
       <TextBlock Text="进度文件或槽位" Style="{StaticResource Muted}" Margin="0,12,0,6"/>
       <Grid>
        <ComboBox ItemsSource="{Binding CrossSave.SwitchFileOptions}" SelectedValue="{Binding CrossSave.SelectedSwitchFile}" SelectedValuePath="Path" DisplayMemberPath="Label" IsEnabled="{Binding CrossSave.CanChooseFile}" AutomationProperties.Name="Switch 进度文件与槽位">
         <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding CanCompare}"/></Style></ComboBox.ItemContainerStyle>
        </ComboBox>
        <TextBlock Text="选择进度文件或槽位" Foreground="{DynamicResource Secondary}" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CrossSave.SelectedSwitchFile}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
       <TextBlock Text="{Binding CrossSave.FileStatus}" Foreground="{DynamicResource Secondary}" Margin="0,10,0,10"/>
       <WrapPanel Margin="0,0,0,10"><Button Content="重新读取槽位" Command="{Binding Commands[CrossSaveRefreshFiles]}" Margin="0,0,10,0"/><Button Content="刷新主机资料" Command="{Binding Commands[Refresh]}"/></WrapPanel>
       <TextBlock Text="{Binding CrossSave.SwitchSummary}"/>
      </StackPanel>
     </Border>
     <Expander Header="Steam Cloud 与存档时间" Margin="0,4,0,16">
      <TextBlock Text="读取前请退出游戏；写入电脑前需退出 Steam。文件修改时间、存档提交时间和最近读取时间会分别标注。迁移后若云端替换本地文件，请保留两端快照并手动选择。哈迪斯官方跨平台云同步与 USB 迁移分开使用。" Foreground="{DynamicResource Secondary}" Margin="0,12,0,0"/>
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,14,0,0">
    <TextBlock Text="{Binding CrossSave.Comparison}" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Text="{Binding CrossSave.Gate}" Foreground="{DynamicResource Secondary}" Margin="0,0,0,12"/>
    <Button Content="读取并比较 · 同时备份双端" Command="{Binding Commands[CrossSaveRead]}" Style="{StaticResource Primary}"/>
    <WrapPanel Margin="0,10,0,0">
     <Button Content="迁移到 Switch" Command="{Binding Commands[CrossSaveToSwitch]}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding CrossSave.Gate}"/>
     <Button Content="迁移到电脑" Command="{Binding Commands[CrossSaveToPc]}" Margin="10,0,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding CrossSave.Gate}"/>
     <Button Content="连接诊断" Command="{Binding Commands[Navigate]}" CommandParameter="diagnostics" Margin="10,0,0,0" Style="{StaticResource Quiet}"/>
    </WrapPanel>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
